{
  "name": "erp-back",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.mjs",
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "start:deploy": "npm run db:migrate && npm run db:seed && npm start",
    "build": "node scripts/check.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.mjs",
    "test": "node --test test/unit.test.mjs",
    "test:integration": "node --test test/integration.test.mjs"
  },
  "dependencies": {
    "pg": "8.23.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  }
}
